# Variáveis de ambiente — backend Orvexa/Prime Digital (Vercel)
# Configure em: painel da Vercel → seu projeto → Settings → Environment Variables.
# NUNCA commite valores reais no Git.

# 1) InfinitePay: sua InfiniteTag (usuário no app InfinitePay, SEM o $)
INFINITEPAY_HANDLE=erick-siqueira-bg2

# 2) Vercel KV (crie em Storage → Create Database → KV e conecte ao projeto;
#    a Vercel preenche essas duas automaticamente ao conectar)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 3) URL pública do backend (ex: https://orvexa-backend.vercel.app)
#    Usada no webhook da InfinitePay e no redirect pós-pagamento.
PUBLIC_URL=

# 4) URL do site de vendas (link "voltar ao site" na página de entrega)
SITE_URL=

# 5) Resend (envio de e-mails): https://resend.com → API Keys
RESEND_API_KEY=

# 6) E-mail remetente (precisa do domínio verificado no Resend)
FROM_EMAIL=Orvexa Digital <acesso@seudominio.com>

# 7) Seu e-mail (recebe alertas de estoque baixo/esgotado)
ADMIN_EMAIL=

# 8) Token do painel de estoque (invente uma senha forte)
#    Acesse: https://SEU-BACKEND.vercel.app/admin.html
ADMIN_TOKEN=

# 9) WhatsApp de atendimento
WHATSAPP_URL=https://wa.me/5521992936790
